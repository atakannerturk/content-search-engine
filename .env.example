# Copy to .env and adjust. Every value below is also the built-in default,
# so the service starts without any of them set (except a reachable database).

# HTTP server
HTTP_ADDR=:8080

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://app:app@localhost:5432/content?sslmode=disable

# Content providers (mock endpoints supplied with the assignment)
PROVIDER1_URL=https://raw.githubusercontent.com/WEG-Technology/mock/refs/heads/main/v2/provider1
PROVIDER2_URL=https://raw.githubusercontent.com/WEG-Technology/mock/refs/heads/main/v2/provider2
PROVIDER_RATE_LIMIT_RPS=2
PROVIDER_BURST=2
PROVIDER_TIMEOUT=10s
PROVIDER_MAX_PAGES=10
PROVIDER_MAX_RETRIES=3
PROVIDER_MAX_BODY_BYTES=10485760

# Synchronisation
SYNC_ON_START=true
SYNC_INTERVAL=10m
SYNC_TIMEOUT=2m
SYNC_TOKEN=
DEACTIVATE_MAX_RATIO=0.5
RESCORE_INTERVAL=1m

# Cache: memory (single instance) or redis
CACHE_BACKEND=memory
CACHE_TTL=60s
CACHE_MAX_ENTRIES=10000
REDIS_ADDR=localhost:6379

# Inbound API rate limiting (per client IP)
API_RATE_LIMIT_RPS=20
API_RATE_LIMIT_BURST=40
TRUST_PROXY=false

# Logging: level debug|info|warn|error, format json|text
LOG_LEVEL=info
LOG_FORMAT=text
